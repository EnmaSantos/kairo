DATABASE_URL=sqlite:///./kairo.db
SECRET_KEY=dev-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Comma-separated browser origins for a deployed Kairo UI. Local origins are
# already allowed by default.
CORS_ALLOWED_ORIGINS=
# Public Google OAuth web client ID (ends in .apps.googleusercontent.com).
# This must match VITE_GOOGLE_CLIENT_ID in kairo-frontend/.env.example.
# A client ID is safe to commit; never add a Google client secret to this project.
GOOGLE_CLIENT_ID=
