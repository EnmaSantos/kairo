VITE_API_URL=http://127.0.0.1:8000
# Hosted builds should leave AI disabled. `start-kairo.sh` overrides this with
# local mode and an ephemeral loopback token for the current session.
VITE_AI_MODE=disabled
VITE_LOCAL_AI_URL=http://127.0.0.1:8001
# Public Google OAuth web client ID. Keep this identical to GOOGLE_CLIENT_ID
# in the root .env.example so local clones can use the same Google sign-in.
VITE_GOOGLE_CLIENT_ID=
